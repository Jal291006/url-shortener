# Port configuration
PORT=5000

# MongoDB Connection String (Replace with your MongoDB Atlas or local MongoDB URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/urlshortener?retryWrites=true&w=majority
# Or local: mongodb://127.0.0.1:27017/urlshortener
MONGO_URI=mongodb://127.0.0.1:27017/urlshortener
